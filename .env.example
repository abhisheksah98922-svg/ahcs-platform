# ==============================================================================
# AHCS — Advanced Health Care System (.env.example)
# Private Healthcare Identity, Card Verification & Health Access Platform
# Domain: https://ahcs.in
# ==============================================================================

# Node Environment
NODE_ENV="development"

# Canonical App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database (with connection pooling)
DATABASE_URL="postgresql://ahcs_user:ahcs_password@localhost:5432/ahcs_db?schema=public&sslmode=prefer"

# Cryptographic & Session Secrets (MUST be at least 32 characters in production)
SESSION_SECRET="replace-with-a-secure-random-64-character-hex-secret-in-production"
PEPPER_SECRET="replace-with-a-secure-random-32-character-pepper-secret-in-production"

# Redis Cache & Rate Limiting (Upstash / local Redis)
REDIS_URL="redis://localhost:6379"

# Private S3-Compatible Object Storage (Indian jurisdiction ap-south-1 recommended)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-south-1"
S3_BUCKET="ahcs-documents-vault"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# SMS Gateway Configuration (India DLT Registered Header: AHCSIN)
# Dev mode falls back to local console mock
SMS_GATEWAY_API_KEY=""
SMS_SENDER_ID="AHCSIN"
