# Database Configuration
DATABASE_URL="postgresql://ahcs_user:ahcs_password@localhost:5432/ahcs_db?schema=public"

# Redis Configuration (Cache & Token Lookup)
REDIS_URL="redis://localhost:6379"

# Security & Secrets
SESSION_SECRET="change-this-to-a-secure-random-64-character-secret"
PEPPER_SECRET="secure-pepper-for-sensitive-hash-matching"

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# S3 Storage Configuration
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="ahcs-documents-vault"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
