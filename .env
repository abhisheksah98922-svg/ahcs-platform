# AHCS Environment Configuration - Production & Staging Specification

# Primary PostgreSQL 16+ Database Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ahcs?schema=public"

# Redis Cache & Session Broker (for rate-limiting, OTP TTL, and transient session caching)
REDIS_URL="redis://localhost:6379"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay Production / Staging Secret Keys
RAZORPAY_KEY_ID="rzp_live_ahcs_key"
RAZORPAY_KEY_SECRET="ahcs_prod_webhook_secret_hmac"

# Dynamic QR / Encryption Secret
DYNAMIC_TOKEN_SECRET="ahcs_prod_crypto_entropy_token_secret_key_2026"
SESSION_COOKIE_SECRET="ahcs_secure_session_encryption_key_production"
