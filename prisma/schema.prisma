datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum SystemRole {
  CITIZEN
  VERIFICATION_OFFICER
  DOCTOR
  NURSE_CLINICAL
  RECEPTION
  ORG_ADMIN
  PLATFORM_ADMIN
}

enum ClientIdStatus {
  APPLICATION
  PENDING_VERIFICATION
  VERIFICATION_REQUIRED
  VERIFIED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VerificationCaseStatus {
  UNASSIGNED
  UNDER_REVIEW
  INFO_REQUESTED
  APPROVED
  REJECTED
}

enum DocType {
  AADHAAR_CARD
  PAN_CARD
  VOTER_ID
  PASSPORT
  DRIVING_LICENSE
  BIRTH_CERTIFICATE
}

enum DocVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ConsentScope {
  FULL_RECORDS
  EMERGENCY_ONLY
  ALLERGIES_AND_MEDS
  SPECIFIC_FACILITY
}

enum ConsentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum FamilyRelationType {
  SPOUSE
  CHILD_MINOR
  CHILD_ADULT
  PARENT
  LEGAL_GUARDIAN
}

// ----------------------------------------------------
// CORE IDENTITY & AUTHENTICATION MODELS
// ----------------------------------------------------

model User {
  id              String       @id @default(uuid())
  phone           String       @unique // E.164 format (+91...)
  phoneVerifiedAt DateTime?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relationships
  userRoles       UserRole[]
  sessions        Session[]
  profile         Profile?
  clientIdRecord  ClientId?

  // Assigned/Reviewed Verification Cases (distinct relations)
  assignedCases   VerificationCase[] @relation("OfficerAssignedCases")
  reviewedCases   VerificationCase[] @relation("OfficerReviewedCases")

  // Consent & Family
  consentsGranted  ConsentGrant[]    @relation("Granter")
  consentsReceived ConsentGrant[]    @relation("Grantee")
  familyMembers    FamilyLink[]      @relation("FamilySubject")
  linkedByFamily   FamilyLink[]      @relation("FamilyRelative")

  // Emergency Break-Glass (Clinical Staff vs Patient)
  breakGlassStaffSessions   EmergencyAccessSession[] @relation("BreakGlassStaff")
  breakGlassPatientSessions EmergencyAccessSession[] @relation("BreakGlassPatient")

  // Auditing: NO CASCADE DELETE
  auditLogs        AuditLog[]        @relation("ActionActor")

  // Clinical, Records, Memberships & Corporate
  medicalRecords          MedicalRecord[]
  medicalDocuments        MedicalDocument[]
  appointments            Appointment[]
  subscriptions           MemberSubscription[]
  payments                Payment[]
  notifications           Notification[]
  employeeMemberships     EmployeeMembership[]
  providerStaff           ProviderStaff[]

  @@index([phone])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  sessionTokenHash String    @unique
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastActiveAt     DateTime  @default(now())
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionTokenHash])
}

model OtpAttempt {
  id           String    @id @default(uuid())
  phone        String    // E.164 (+91...)
  otpHash      String    // Salted SHA-256 HMAC
  attemptCount Int       @default(0)
  expiresAt    DateTime
  consumedAt   DateTime?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  @@index([phone, createdAt])
}

model UserRole {
  id             String        @id @default(uuid())
  userId         String
  role           SystemRole
  organizationId String?
  assignedAt     DateTime      @default(now())
  revokedAt      DateTime?

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Partial unique indexes enforced at DB level for nullable organizationId
  @@index([userId, role])
  @@index([organizationId])
}

model Organization {
  id           String     @id @default(uuid())
  name         String
  code         String     @unique // Unique short slug or facility code
  facilityType String     // Hospital, Clinic, Diagnostic, VerificationCenter
  address      String
  city         String
  state        String
  pincode      String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  userRoles    UserRole[]
  breakGlassSessions EmergencyAccessSession[]

  @@index([code])
}

// ----------------------------------------------------
// PROFILE & VERIFICATION
// ----------------------------------------------------

model Profile {
  id                    String            @id @default(uuid())
  userId                String            @unique
  fullName              String
  dateOfBirth           DateTime
  gender                String
  bloodGroup            String?
  bloodGroupVerified    Boolean           @default(false)
  bloodGroupVerifiedAt  DateTime?
  bloodGroupVerifiedById String?
  addressLine1          String
  city                  String
  state                 String
  pincode               String
  emergencyContactName  String
  emergencyContactPhone String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents             IdentityDocument[]
  verificationCase      VerificationCase?

  @@index([fullName, dateOfBirth])
}

model IdentityDocument {
  id                 String                @id @default(uuid())
  profileId          String
  docType            DocType
  documentNumberMasked String?             // e.g. "XXXX-XXXX-1234" (UIDAI masked standard)
  documentNumberHash String?               // HMAC-SHA256 with server-side pepper for duplicate detection
  storagePath        String                // Private bucket path: docs/{userId}/{uuid}
  mimeType           String                // application/pdf, image/jpeg, image/png
  fileSizeBytes      Int
  status             DocVerificationStatus @default(PENDING)
  rejectionReason    String?
  uploadedAt         DateTime              @default(now())
  verifiedAt         DateTime?

  profile            Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([documentNumberHash])
}

model VerificationCase {
  id                String                 @id @default(uuid())
  profileId         String                 @unique
  assignedOfficerId String?
  reviewedById      String?
  status            VerificationCaseStatus @default(UNASSIGNED)
  notes             String?
  infoRequestNote   String?
  duplicateFlag     Boolean                @default(false)
  duplicateNotes    String?
  reviewedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  profile           Profile                @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assignedOfficer   User?                  @relation("OfficerAssignedCases", fields: [assignedOfficerId], references: [id], onDelete: SetNull)
  reviewedBy        User?                  @relation("OfficerReviewedCases", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([assignedOfficerId])
  @@index([reviewedById])
}

// ----------------------------------------------------
// CLIENT ID & SMART HEALTH CARD
// ----------------------------------------------------

model ClientId {
  id               String         @id @default(uuid())
  userId           String         @unique
  clientId         String         @unique // Format: AHCS-XXXX-XXXX-XXXX (secure random non-sequential)
  status           ClientIdStatus @default(APPLICATION)
  issuedAt         DateTime?
  lastStatusChange DateTime       @default(now())
  statusReason     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardTokens       CardToken[]

  @@index([clientId])
  @@index([status])
}

model CardToken {
  id         String    @id @default(uuid())
  clientIdId String
  tokenHash  String    @unique // Hashed rotating reference
  signature  String    // Signed payload
  nonce      String    @unique
  expiresAt  DateTime
  isRevoked  Boolean   @default(false)
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  clientIdRecord ClientId @relation(fields: [clientIdId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([expiresAt])
}

// ----------------------------------------------------
// CONSENT, FAMILY & EMERGENCY ACCESS
// ----------------------------------------------------

model ConsentGrant {
  id         String        @id @default(uuid())
  granterId  String        // Patient granting access
  granteeId  String        // Recipient user
  scope      ConsentScope
  status     ConsentStatus @default(ACTIVE)
  validFrom  DateTime      @default(now())
  validUntil DateTime?
  revokedAt  DateTime?
  createdAt  DateTime      @default(now())

  granter    User          @relation("Granter", fields: [granterId], references: [id], onDelete: Cascade)
  grantee    User          @relation("Grantee", fields: [granteeId], references: [id], onDelete: Cascade)

  @@index([granterId, status])
  @@index([granteeId, status])
}

model FamilyLink {
  id             String             @id @default(uuid())
  subjectUserId  String             // Primary account holder
  relativeUserId String             // Family member account
  relationType   FamilyRelationType
  isVerified     Boolean            @default(false)
  verifiedAt     DateTime?
  createdAt      DateTime           @default(now())

  subjectUser    User               @relation("FamilySubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  relativeUser   User               @relation("FamilyRelative", fields: [relativeUserId], references: [id], onDelete: Cascade)

  @@unique([subjectUserId, relativeUserId])
  @@index([subjectUserId])
}

model EmergencyAccessSession {
  id               String                 @id @default(uuid())
  actorUserId      String
  patientUserId    String
  organizationId   String
  justification    String
  ipAddress        String
  userAgent        String
  sessionStartedAt DateTime               @default(now())
  sessionExpiresAt DateTime
  patientNotified  Boolean                @default(false)
  notifiedAt       DateTime?
  createdAt        DateTime               @default(now())

  actor            User                   @relation("BreakGlassStaff", fields: [actorUserId], references: [id], onDelete: Restrict)
  patient          User                   @relation("BreakGlassPatient", fields: [patientUserId], references: [id], onDelete: Restrict)
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  events           EmergencyAccessEvent[]

  @@index([actorUserId])
  @@index([patientUserId])
  @@index([sessionStartedAt])
}

model EmergencyAccessEvent {
  id         String                 @id @default(uuid())
  sessionId  String
  fieldGroup String                 // e.g. "ALLERGIES", "BLOOD_GROUP", "CRITICAL_CONDITIONS", "CURRENT_MEDS"
  action     String                 @default("VIEW")
  accessedAt DateTime               @default(now())

  session    EmergencyAccessSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([fieldGroup])
}

// ----------------------------------------------------
// APPEND-ONLY AUDIT LOG (NO CASCADE DELETE)
// ----------------------------------------------------

model AuditLog {
  id             String    @id @default(uuid())
  actorId        String?   // User who performed the action (SetNull on user deletion)
  action         String    // E.g. "AUTH.OTP_REQUEST", "CARD.TOKEN_SCANNED", "RECEPTION.VERIFY_IDENTITY"
  entityType     String    // E.g. "Profile", "IdentityDocument", "ClientId", "EmergencyAccessSession"
  entityId       String?
  organizationId String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?     // Strictly sanitized: NO OTPs, NO passwords, NO full Aadhaar, NO credentials
  timestamp      DateTime  @default(now())

  actor          User?     @relation("ActionActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, timestamp])
  @@index([action, timestamp])
  @@index([entityType, entityId])
}

// ----------------------------------------------------
// CLINICAL RECORDS & DOCUMENT VAULT
// ----------------------------------------------------

model MedicalRecord {
  id                 String   @id @default(uuid())
  userId             String
  authorProviderId   String?
  authorDoctorName   String
  recordType         String   // PRESCRIPTION, LAB_REPORT, CONSULTATION_NOTE, DISCHARGE_SUMMARY
  title              String
  clinicalDiagnosis  String?
  clinicalNotes      String?
  medications        Json?
  labObservations    String?
  recordDate         DateTime @default(now())
  verificationStatus String   @default("CLINICALLY_VERIFIED")
  source             String   @default("PROVIDER")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([authorProviderId])
}

model MedicalDocument {
  id           String   @id @default(uuid())
  userId       String
  documentType String   // LAB_REPORT, PRESCRIPTION, DISCHARGE_SUMMARY, SCAN_XRAY, INSURANCE_DOC
  title        String
  storagePath  String   // S3 or private bucket key
  mimeType     String
  fileSizeBytes Int
  documentHash String
  uploadedAt   DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentHash])
}

// ----------------------------------------------------
// HEALTHCARE PROVIDER NETWORK & APPOINTMENTS
// ----------------------------------------------------

model Provider {
  id                 String                 @id @default(uuid())
  name               String
  category           String                 // HOSPITAL, CLINIC, LAB, PHARMACY
  registrationNumber String                 @unique
  medicalCouncil     String
  address            String
  city               String
  state              String
  pinCode            String
  phone              String
  email              String
  services           String[]
  partnerTier        String                 @default("STANDARD")
  status             String                 @default("PENDING_VERIFICATION") // PENDING_VERIFICATION, VERIFIED, SUSPENDED, REJECTED
  verifiedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  staff              ProviderStaff[]
  verification       ProviderVerification?

  @@index([category])
  @@index([city])
  @@index([status])
}

model ProviderStaff {
  id                         String    @id @default(uuid())
  providerId                 String
  userId                     String
  role                       String    // DOCTOR, NURSE, RECEPTION, ADMIN
  doctorRegistrationNumber   String?
  isActive                   Boolean   @default(true)
  createdAt                  DateTime  @default(now())

  provider                   Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([userId])
}

model ProviderVerification {
  id                  String    @id @default(uuid())
  providerId          String    @unique
  reviewedById        String?
  status              String    @default("PENDING")
  licenseDocumentPath String?
  notes               String?
  reviewedAt          DateTime?
  createdAt           DateTime  @default(now())

  provider            Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model HealthcareService {
  id             String   @id @default(uuid())
  providerId     String?
  serviceCode    String   @unique
  name           String
  category       String
  description    String?
  basePricePaise Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([category])
}

model Appointment {
  id              String   @id @default(uuid())
  userId          String
  providerId      String?
  doctorName      String
  appointmentDate DateTime
  status          String   @default("CONFIRMED") // CONFIRMED, COMPLETED, CANCELLED
  reason          String?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId])
}

// ----------------------------------------------------
// MEMBERSHIPS, SUBSCRIPTIONS & ENTITLEMENTS
// ----------------------------------------------------

model MembershipPlan {
  id                            String               @id @default(uuid())
  code                          String               @unique // AHCS-PLAN-CORE, AHCS-PLAN-PREMIUM, etc.
  name                          String
  description                   String?
  tier                          String               // INDIVIDUAL, FAMILY, CORPORATE
  pricePaise                    Int
  durationMonths                Int
  consultationDiscountPercent   Int                  @default(0)
  diagnosticDiscountPercent     Int                  @default(0)
  emergencyCoveragePaise        Int                  @default(0)
  isActive                      Boolean              @default(true)
  createdAt                     DateTime             @default(now())

  subscriptions                 MemberSubscription[]
}

model MemberSubscription {
  id            String               @id @default(uuid())
  userId        String
  planId        String
  status        String               @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  startDate     DateTime             @default(now())
  endDate       DateTime
  autoRenew     Boolean              @default(false)
  createdAt     DateTime             @default(now())

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          MembershipPlan       @relation(fields: [planId], references: [id])
  entitlements  ServiceEntitlement[]

  @@index([userId])
  @@index([status])
}

model ServiceEntitlement {
  id              String             @id @default(uuid())
  subscriptionId  String
  serviceCategory String             // CONSULTATION, DIAGNOSTICS, EMERGENCY, HOME_CARE
  maxUsageCount   Int?
  remainingCount  Int?
  discountPercent Int                @default(0)
  createdAt       DateTime           @default(now())

  subscription    MemberSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

// ----------------------------------------------------
// CORPORATE HEALTHCARE COORDINATION
// ----------------------------------------------------

model CorporateOrganisation {
  id                 String               @id @default(uuid())
  name               String
  registrationNumber String               @unique
  domain             String?
  contactEmail       String
  contactPhone       String
  activePlan         String               @default("ENTERPRISE_SHIELD")
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())

  employees          EmployeeMembership[]
}

model EmployeeMembership {
  id              String                @id @default(uuid())
  corporateOrgId  String
  userId          String
  employeeId      String
  status          String                @default("ACTIVE") // ACTIVE, SUSPENDED, TERMINATED
  sponsoredAt     DateTime              @default(now())

  corporate       CorporateOrganisation @relation(fields: [corporateOrgId], references: [id], onDelete: Cascade)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([corporateOrgId, employeeId])
  @@index([userId])
}

// ----------------------------------------------------
// BILLING, PAYMENTS & NOTIFICATIONS
// ----------------------------------------------------

model Payment {
  id               String   @id @default(uuid())
  userId           String
  amountPaise      Int
  currency         String   @default("INR")
  status           String   @default("CREATED") // CREATED, PAID, FAILED, REFUNDED
  gateway          String   @default("RAZORPAY")
  gatewayOrderId   String?
  gatewayPaymentId String?
  gatewaySignature String?
  planId           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([gatewayOrderId])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  message   String
  category  String    @default("SYSTEM") // SYSTEM, EMERGENCY, VERIFICATION, APPOINTMENT
  channel   String    @default("IN_APP") // IN_APP, EMAIL, SMS
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ----------------------------------------------------
// SERVICE VERTICAL BOOKINGS & REQUESTS
// ----------------------------------------------------

model MobileMedicalRequest {
  id               String   @id @default(uuid())
  organizationName String
  contactPerson    String
  phone            String
  email            String?
  expectedPeople   Int      @default(50)
  location         String
  city             String
  state            String
  pinCode          String
  preferredDate    DateTime
  requiredServices String[]
  notes            String?
  status           String   @default("REQUESTED") // REQUESTED, SCHEDULED, DISPATCHED, COMPLETED, CANCELLED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([city, status])
}

model HomeCareRequest {
  id            String   @id @default(uuid())
  patientName   String
  serviceType   String
  location      String
  city          String
  state         String
  pinCode       String
  preferredDate DateTime
  contactPhone  String
  contactEmail  String?
  notes         String?
  status        String   @default("REQUESTED") // REQUESTED, ASSIGNED, COMPLETED, CANCELLED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([city, status])
}
